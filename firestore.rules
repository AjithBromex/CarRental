rules_version = '2';

// Only the single admin account can read or write business data.
// Admin UID: YUadCTU9tVhXttsE9rq1AcHvE492
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "YUadCTU9tVhXttsE9rq1AcHvE492";
    }

    function validVehicle(d) {
      return d.name is string && d.name.size() > 0
        && d.registrationNumber is string && d.registrationNumber.size() > 0
        && d.status in ['available', 'rented', 'maintenance'];
    }

    function validRental(d) {
      return d.vehicleId is string && d.vehicleId.size() > 0
        && d.driverName is string && d.driverName.size() > 0
        && d.phoneNumber is string
        && d.totalAmount is number && d.totalAmount >= 0
        && d.amountPaid is number && d.amountPaid >= 0
        && d.amountPaid <= d.totalAmount
        && d.days is number && d.days > 0
        && d.status in ['active', 'completed', 'cancelled'];
    }

    match /vehicles/{vehicleId} {
      allow read, write: if isAdmin();
    }

    match /rentals/{rentalId} {
      allow read, write: if isAdmin();
    }

    // Default rule for all other documents
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
